# ---------------------------------------------------------------- provider
# ollama  = local models, nothing leaves the machine (dev default)
# mistral = hosted API, required for free-tier deployment
LLM_PROVIDER=ollama

# ---------------------------------------------------------------- ollama (dev)
OLLAMA_HOST=http://127.0.0.1:11434
# Inside Docker, Ollama on the host is reachable at:
# OLLAMA_HOST=http://host.docker.internal:11434

# ---------------------------------------------------------------- mistral (prod)
MISTRAL_API_KEY=

# ---------------------------------------------------------------- models
# Optional. Each role falls back to a sensible default for the chosen provider.
# LLM_MODEL overrides all three chat roles at once — handy when you only have
# one model pulled locally.
# LLM_MODEL=llama3.2:latest
# CLASSIFIER_MODEL=
# SQL_MODEL=
# NARRATIVE_MODEL=
# EMBED_MODEL=

# ---------------------------------------------------------------- tuning
EMBED_BATCH_SIZE=32
API_MAX_RETRIES=4
API_BACKOFF_SECONDS=1.5
MAX_RESULT_ROWS=200
MAX_UPLOAD_BYTES=52428800

# ---------------------------------------------------------------- storage
# Leave both blocks empty for local files (dev). Fill them in for full
# dev/prod parity — nothing then touches the local filesystem.

# MotherDuck = hosted DuckDB. Same SQL dialect, so no prompt changes.
# Get a token at https://app.motherduck.com  -> Settings -> Access Tokens
MOTHERDUCK_TOKEN=

# Chroma Cloud = hosted vectors. Same client API as the local store.
# Get these at https://trychroma.com -> your database -> Connect
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=sheetsense

# Only used when the two blocks above are empty.
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
